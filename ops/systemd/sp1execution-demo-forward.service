[Unit]
Description=SP1Execution Demo forward cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Desktop/projs/SP1Execution
EnvironmentFile=%h/Desktop/projs/SP1Execution/.env
ExecStart=%h/Desktop/projs/SP1Execution/.venv/bin/python %h/Desktop/projs/SP1Execution/scripts/sp1_demo_forward_runner_v04.py --db-path %h/Desktop/projs/SP1Execution/state/sp1execution.sqlite --confirm-demo
UMask=0077
NoNewPrivileges=true
TimeoutStartSec=10min
