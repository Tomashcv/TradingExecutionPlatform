[Unit]
Description=SP1Execution Demo forward cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/TradingExecutionPlatform
EnvironmentFile=%h/TradingExecutionPlatform/.env
ExecStart=%h/TradingExecutionPlatform/.venv/bin/python %h/TradingExecutionPlatform/scripts/sp1_demo_forward_runner_v04.py --db-path %h/TradingExecutionPlatform/state/sp1execution.sqlite --confirm-demo
UMask=0077
NoNewPrivileges=true
TimeoutStartSec=10min
